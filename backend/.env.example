# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# --- Database (PostgreSQL). Tez sinash uchun USE_SQLITE=1 qiling ---
USE_SQLITE=0
POSTGRES_DB=qrfeedback
POSTGRES_USER=qrfeedback
POSTGRES_PASSWORD=qrfeedback
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# --- Redis / Celery / Channels (bo'sh bo'lsa: in-memory + eager rejim) ---
REDIS_URL=redis://localhost:6379/0
CELERY_EAGER=0
# --- Web Push (VAPID). `python manage.py generate_vapid` bilan yarating ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@feedback.uz
# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@feedback.uz
