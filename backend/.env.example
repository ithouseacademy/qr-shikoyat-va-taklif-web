# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=qrfeedback.webstorm.uz,qrfeedbackbackend.webstorm.uz,.up.railway.app,.railway.app
FRONTEND_URL=https://qrfeedback.webstorm.uz
BACKEND_URL=https://qrfeedbackbackend.webstorm.uz
CORS_ALLOWED_ORIGINS=https://qrfeedback.webstorm.uz
CSRF_TRUSTED_ORIGINS=https://qrfeedback.webstorm.uz,https://qrfeedbackbackend.webstorm.uz,https://*.up.railway.app
# --- Database ---
# Railway Postgres plagini DATABASE_URL ni avtomatik beradi — shu ishlatiladi.
# DATABASE_URL=postgresql://postgres:parol@host:5432/railway
# DATABASE_URL bo'lmasa: USE_SQLITE=1 (lokal) yoki POSTGRES_* (qo'lda)
USE_SQLITE=0
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# --- Redis / Celery / Channels (bo'sh bo'lsa: in-memory + eager rejim) ---
REDIS_URL=
CELERY_EAGER=0
# --- Fayllar (Railway volume: /app/media) ---
MEDIA_ROOT=/app/media
# --- Web Push (VAPID). `python manage.py generate_vapid` bilan yarating ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@feedback.uz
# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@feedback.uz
